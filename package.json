{
  "name": "dax-jadoo",
  "version": "1.0.0",
  "description": "Modular, modern Jadoo Travel frontend architecture",
  "main": "script.js",
  "scripts": {
    "build": "tsc --noEmit && node build.js",
    "build:server": "tsc --project server/tsconfig.json",
    "build:all": "npm run build && npm run build:server",
    "start": "node server/dist/index.js",
    "bundle": "node build.js",
    "type-check": "tsc --noEmit",
    "watch": "node build.js --watch",
    "server": "tsx watch server/src/index.ts",
    "db:setup": "tsx server/src/db/init-db.ts",
    "test": "tsx server/tests/test-suite.ts",
    "test:e2e": "tsx scripts/run-full-e2e-test.ts && node scripts/verify-dom-buttons.cjs && node scripts/test-modal-close-buttons.cjs && node scripts/test-phase1-fixes.cjs && tsx scripts/test-phase2-fixes.ts",
    "dev:all": "concurrently \"npm run watch\" \"npm run server\"",
    "db:view": "node scripts/view-db.cjs"
  },
  "keywords": [
    "travel",
    "jadoo",
    "typescript",
    "modular"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.23.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "esbuild": "^0.28.2",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "typescript": "^5.9.3"
  }
}
